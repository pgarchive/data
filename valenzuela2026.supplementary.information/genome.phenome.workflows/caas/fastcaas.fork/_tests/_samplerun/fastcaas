### Function runslice (collects the )
def runslice(the_alignment, options_object):

    # Inputs (transferring parsed options_object to variables)
    alignment_format = options_object.ali_format

    # Alignment slice: 1- Calculate column treshold

    with open(options.config_file) as cfg_handle:
        cfg_list = cfg_handle.read().splitlines()
    
    values = []

    for x in cfg_list:
        try:
            c = x.split("\t")
            values.append(c[1])
        except:
            pass
    
    fg_species = values.count("1")
    bg_species = values.count("0")


    # Alignment slicing: sum the null values (allowed_gaps + allowed_missing_species)

    sum_nulls_fg = 0

    for x in (options.max_fg_gaps_string,options.max_fg_miss_string):
        try:
            sum_nulls_fg = sum_nulls_fg + int(x)
        except:
            pass

    sum_nulls_bg = 0

    for x in (options.max_bg_gaps_string,options.max_bg_miss_string):
        try:
            sum_nulls_bg = sum_nulls_bg + int(x)
        except:
            pass



    fg_threshold = fg_species - sum_nulls_fg
    bg_threshold = bg_species - sum_nulls_bg


    c_threshold = max(fg_threshold, bg_threshold)


    # Alignment slice: 2- Filter positions (slice alignment)

    out = slice(the_alignment, alignment_format = alignment_format, column_threshold = c_threshold, max_gaps = float(options.max_gaps_pos_string))

    return out


def fastcaas_core(options_object, sliced_alignment, alignment_format, bootstrap_object, output_bootstrap, output_single_run = "none"):

    # Filtering settings (transferring parsed options_object to variables)

    ud_admitted_scenarios = options_object.scenarios_string.split(",")

    user_def_max_bg_gaps = options_object.max_bg_gaps_string
    user_def_max_fg_gaps = options_object.max_fg_gaps_string
    user_def_max_gaps = options_object.max_gaps_string

    user_def_max_fg_miss = options_object.max_fg_miss_string
    user_def_max_bg_miss = options_object.max_bg_miss_string
    user_def_max_miss = options_object.max_miss_string

    pp = sliced_alignment

    # Step 1: bootstrap

    boot_on_single_alignment(
                    trait_config_file= options_object.config_file,
                    simulated_traits= bootstrap_object,
                    sliced_object = pp,
                    max_fg_gaps = user_def_max_fg_gaps,
                    max_bg_gaps = user_def_max_bg_gaps,
                    max_overall_gaps = user_def_max_gaps,
                    
                    max_fg_miss = user_def_max_fg_miss,
                    max_bg_miss = user_def_max_bg_miss,
                    max_overall_miss = user_def_max_miss,

                    the_admitted_scenarios = ud_admitted_scenarios,
                    output_file = output_bootstrap
                    )

    # Step 2: import the pvalue dictionary

    pval_dictionary = pval(output_bootstrap)

    # Step 3: discovery phase
    discovery( 
                    input_cfg = options_object.config_file,
                    sliced_object = pp,
                    pvalue_dictionary = pval_dictionary,
                    max_fg_gaps = user_def_max_fg_gaps,
                    max_bg_gaps = user_def_max_bg_gaps,
                    max_overall_gaps = user_def_max_gaps,

                    max_fg_miss = user_def_max_fg_miss,
                    max_bg_miss = user_def_max_bg_miss,
                    max_overall_miss = user_def_max_miss,

                    admitted_scenarios = ud_admitted_scenarios,
                    output_file = output_single_run)


    return 0

