### Introduction
# A convergent amino acid substitution or CAAS is an aminoacid change that co-segregate with
# a specific trait.
# Fastcaas is a tool to identify convergent amino acid substitutions from multiple sequence
# alignments (MSA) of orthologous proteins.  

### Options and documentation

program_info = '''
FAST CAAS v. 0.7 (beta)                    
FAST Convergent Amino Acid Substitution detection tool
'''

import sys,os,glob
from optparse import OptionParser

# Option parser

parser = OptionParser()

#   INPUTS

#   Run on single alignment
parser.add_option("-a", "--alignment", dest="single_alignment",
                  help="Run caasper on a single alignment.", default = "none")
#   Run on an alignments folder
parser.add_option("-f", "--alignments_folder", dest="alignments_folder",
                  help="Run caasper on a folder containing more alignments. (-f/--folder $path_to_folder", default = "none")
#   Alignment format
parser.add_option("--fmt", dest="ali_format",
                  help="File format of the alignment (accepted formats in documentation). Default: fasta. Accepted: clustal, emboss, fasta, \
                  fasta-m10, ig, maf, mauve, msf, nexus, phylip, phylip-sequential, phylip-relaxed, stockholm.", default = "fasta")
#   Config file
parser.add_option("-t", "--traitfile", dest="config_file",
                  help="The config file (read documentation). (-c/--config $path_to_config_file", default = "none")

#   FILTERING

#       1. limit output to scenario (default: all scenarios)
parser.add_option("-s", "--scenarios", dest="scenarios_string",
                  help="Limit the result to some scenarios. Scenarios are indicated with numbers from 1 to 4 and must \
                      be provided as comma separated (e.g.: -s 1,2,3). See documentation for more details on the scenarios", default = "1,2,3")

#       2. filter per gaps 
parser.add_option("-g", "--maxgaps", dest="maxgaps_string",
                  help="Filter by gaps ratio (between 0 and 1). This option applies to both bg and fg groups \
                      e.g. -g 0.5 will accept positions with GapsRatio <= 0.5. Default = 1 (all positions accepted).", default = "1")

parser.add_option("-z", "--max_bg_gaps", dest="max_bg_gaps_string",
                  help="Filter by gaps ratio (between 0 and 1). This option applies to the bg group only\
                      e.g. -z 0.5 will accept positions with GapsRatio <= 0.5. Default = 1 (all positions accepted).", default = "1")

parser.add_option("-u", "--max_fg_gaps", dest="max_fg_gaps_string",
                  help="Filter by gaps ratio (between 0 and 1). This option applies to the fg group only\
                      e.g. -u 0.5 will accept positions with GapsRatio <= 0.5. Default = 1 (all positions accepted).", default = "1")


# PARALLELISATION

parser.add_option("-k", "--cpus", dest="number_of_cpus",
                  help="Number of CPUs. Applies to folder-based usage only.", default = "none")


parser.usage = '''\n[ON SINGLE ALIGNMENT FILE]\nfastcaas.py -a $input_alignment -t $trait_file\n
[ON FOLDER WITH SEVERAL ALIGNMENT FILES]\nfastcaas.py -f $the_input_folder/ -t $trait_file'''


(options, args) = parser.parse_args()

# Checks whether the options are correct

if len(sys.argv) == 1:
    print(program_info)
    parser.print_help()
    exit()

if options.single_alignment == "none" and options.alignments_folder == "none":
    print(program_info)
    print("\n\n****ERROR: no input alignment(s) provided****\n\n")
    parser.print_help()
    exit()

elif options.single_alignment != "none" and options.alignments_folder != "none":
    print(program_info)
    print("\n\n****ERROR: you must choose either a single alignment (-a) or to loop on a whole folder (-f) ****\n\n")
    parser.print_help()
    exit()

if options.config_file == "none":
    print(program_info)
    print("\n\n****ERROR: no config file provided****\n\n")
    parser.print_help()
    exit()


# Settings (transferring parsed options to variables)

alignment = options.single_alignment
alignments_folder = options.alignments_folder
alignments_format = options.ali_format
traitfile = options.config_file

# Filtering settings (transferring parsed options to variables)

admitted_scenarios = options.scenarios_string.split(",")

maxgaps = float(options.maxgaps_string)
max_bg_gaps = float(options.max_bg_gaps_string)
max_fg_gaps = float(options.max_fg_gaps_string)

### IMPORT THE MODULES

from disco import *
from boot import *

### INITIALISE THE OUTPUT FOLDER

# The folders in the output

output_folder = traitfile.split("/")[-1] + "_CAAS"
bootstrap_folder = output_folder + "/bootstrap"
single_alignments_folder = output_folder + "/single_alignments"

# Overwrite the folder

if os.path.exists(output_folder):
    os.system("rm -r " + output_folder)

# Create new tree

os.mkdir(output_folder)
os.mkdir(bootstrap_folder)
os.mkdir(single_alignments_folder)

### WORKFLOW 1: DISCOVERY ON SINGLE ALIGNMENT

if alignment != "none":
    output_single_run = single_alignments_folder + "/" + alignment.split("/")[-1] + ".caas"
    output_bootstrap = single_alignments_folder + "/" + alignment.split("/")[-1] + ".bootstrap"

    discovery(  input_alignment = alignment,
                input_cfg = traitfile,
                output_file = output_single_run,
                max_fg_gaps=0,
                max_bg_gaps=0,
                max_overall_gaps=0,
                admitted_scenarios=admitted_scenarios
                )

### WORKFLOW 2: DISCOVERY ON MULTIPLE ALIGNMENT

elif alignments_folder != "none":
    alignments_list = glob.glob(alignments_folder + "/*")

    for a in alignments_list:
        print(a)
        output_single_run = single_alignments_folder + "/" + a.split("/")[-1] + ".caas"
        discovery(  input_alignment = a,
                    input_cfg = traitfile,
                    output_file = output_single_run,
                    max_fg_gaps=0,
                    max_bg_gaps=0,
                    max_overall_gaps=0,
                    admitted_scenarios=admitted_scenarios
                    )

