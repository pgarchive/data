foreground_spc <- names(trait[trait==1])
allspecs=primate_genesTrees$masterTree$tip.label
foreground=ifelse(allspecs %in% foreground_spc, 1, 0)
names(foreground)=allspecs
permulated_phenotype <- simBinPhenoVec(primate_genesTrees, "Otolemur_garnettii", trait)
