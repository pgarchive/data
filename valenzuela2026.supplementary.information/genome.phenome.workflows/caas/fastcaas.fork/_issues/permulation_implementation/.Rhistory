#!/usr/bin/env Rscript
#,------. ,---.   ,---. ,--------. ,-----.  ,---.    ,---.   ,---.
#|  .---'/  O  \ '   .-''--.  .--''  .--./ /  O  \  /  O  \ '   .-'
#|  `--,|  .-.  |`.  `-.   |  |   |  |    |  .-.  ||  .-.  |`.  `-.
#|  |`  |  | |  |.-'    |  |  |   '  '--'\|  | |  ||  | |  |.-'    |
#`--'   `--' `--'`-----'   `--'    `-----'`--' `--'`--' `--'`-----'
#FAST Convergent Amino Acid Substitution identification tool
#Authors:    Fabio Barteri (fabio.barteri@upf.edu),
#            Xavier Farré (xfarrer@igtp.cat),
#            David de Juan (david.juan@upf.edu).
#MODULE NAME: Permulations
#DESCRIPTION: R function for brownian-motion based permutations (permuLations)
#DEPENDENCIES: none
#CALLED BY: init_bootstrap.py
# Import RERconverge (with required package install)
if (!require("RERconverge", character.only=T, quietly=T)) {
require(devtools)
install_github("nclark-lab/RERconverge", ref="master")
}
library(RERconverge)
library(tibble)
library(readr)
library(ape)
# Inputs
args = commandArgs(trailingOnly=TRUE)
tree <- args[1]
working.directory <- args[2]
number_of_cycles <- as.numeric(args[3])
# Create the working folder
make.dir <- function(fp) {
if(!file.exists(fp)) { dir.create(fp) }
else { unlink(fp, recursive = TRUE)
dir.create(fp) }
}
output.directory = paste(working.directory, "cycles", sep="/")
make.dir(output.directory)
# Read the tree object.
#imported.tree <- read_file(tree)
tree.o <- read.tree(tree)
trait <- tree.o$tip.label
l <- length(trait)
values <- runif(n = l, min = 1, max = l*1000)
names(values) <- trait
### SIMULATE
counter = 0
for (j in 1:number_of_cycles){
counter = counter + 1
cycle.tag = paste("b", as.character(counter), sep = "_")
outfile.name = paste(cycle.tag, "csv", sep=".")
outfile.path = paste(output.directory, outfile.name, sep = "/")
permulated_phenotype <- simpermvec(values, tree.o)
x <- enframe(permulated_phenotype)
### Export the result.
write_tsv(x, file=outfile.path)
}
