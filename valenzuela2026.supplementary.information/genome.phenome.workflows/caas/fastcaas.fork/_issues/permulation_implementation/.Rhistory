permulations <- list()
count <- 0
for (j in 1:10000){
count <- count + 1
trait <- as.numeric(as.character(multinomial_final$Trait))
names(trait) <- multinomial_final$label
drop_species <- primate_genesTrees$masterTree$tip.label[!primate_genesTrees$masterTree$tip.label %in% names(trait)]
